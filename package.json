{
  "name": "gebal",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.13.0 <23 || >=24"
  },
  "scripts": {
    "gebal": "tsx packages/cli/src/main.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck",
    "worker": "tsx packages/worker/src/main.ts",
    "demo": "tsx scripts/demo.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "format": "prettier --write packages scripts tests",
    "format:check": "prettier --check packages scripts tests"
  },
  "dependencies": {
    "commander": "15.0.0",
    "smol-toml": "1.9.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "description": "Bring-your-own-AI Solidity review harness with scoped snapshots, evidence and human decisions",
  "license": "MIT"
}
